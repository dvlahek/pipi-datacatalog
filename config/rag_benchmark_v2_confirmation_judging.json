    "1": "related to the topic or entity but insufficient for the information need",
    "0": "does not provide useful evidence for the information need"
  },
  "relation_comparison_rule": {
    "one_side_clear_support_may_receive": 2,
    "grade_3_requires_direct_satisfaction_of_information_need": true
