APP_ENVIRONMENT=development
SENSOR_HUB_BASE_URL=http://webtesting.foi.unizg.hr:3000/api/v1
SENSOR_HUB_USERNAME=
SENSOR_HUB_PASSWORD=
SENSOR_HUB_TIMEOUT_SECONDS=15

# Persistent metadata catalog.
CATALOG_STORE_ENABLED=false
DATABASE_URL=postgresql+psycopg://pipi:pipi_dev@localhost:5432/pipi_catalog

# Optional admin connection used only when the target role/database do not exist yet.
# Keep the real admin password only in your local .env, never in Git.
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/postgres

CATALOG_BOOTSTRAP_IF_EMPTY=true
