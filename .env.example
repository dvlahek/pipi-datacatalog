APP_ENVIRONMENT=development
SENSOR_HUB_BASE_URL=http://webtesting.foi.unizg.hr:3000/api/v1
SENSOR_HUB_USERNAME=
SENSOR_HUB_PASSWORD=
SENSOR_HUB_TIMEOUT_SECONDS=15

# Providers can be enabled/disabled independently.
PROVIDER_SENSOR_HUB_ENABLED=true
PROVIDER_STATIC_WEB_ENABLED=true
PROVIDER_CSV_ENABLED=true
PROVIDER_FOI_DOCUMENTS_ENABLED=true
CSV_DATASETS_CONFIG=config/csv_datasets.json
CATALOG_PUBLIC_BASE_URL=http://127.0.0.1:8000
FOI_DOCUMENTS_BASE_URL=https://dokumenti.foi.hr/document/
FOI_DOCUMENTS_TIMEOUT_SECONDS=20

# Optional server-side GitHub token for higher public API limits.
GITHUB_API_TOKEN=
GITHUB_TIMEOUT_SECONDS=20
GITHUB_INDEX_MAX_FILES=100
GITHUB_INDEX_MAX_FILE_BYTES=262144
GITHUB_INDEX_MAX_TOTAL_BYTES=3145728

# Authentication. Generate local values with: python scripts/setup_auth.py
AUTH_ENABLED=true
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_MINUTES=480
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Web/API hardening. Enable HSTS only behind real HTTPS.
SECURITY_HSTS_ENABLED=false
RESOURCE_FETCH_MAX_BYTES=26214400
RESOURCE_FETCH_TIMEOUT_SECONDS=20
RESOURCE_FETCH_ALLOWED_PORTS=80,443

# RAG/vector retrieval. feature-hash is a deterministic local vector baseline,
# not a semantic language model. It validates pgvector + hybrid retrieval first.
RAG_EMBEDDING_PROVIDER=feature-hash
RAG_EMBEDDING_MODEL=feature-hash-384-v1
RAG_EMBEDDING_DIMENSIONS=384
RAG_EMBEDDING_BATCH_SIZE=128
RAG_EMBEDDING_BACKFILL_LIMIT=10000
RAG_HYBRID_RRF_K=60

# Persistent metadata catalog. Configure these locally; never commit real credentials.
CATALOG_STORE_ENABLED=false
DATABASE_URL=
DATABASE_ADMIN_URL=
CATALOG_BOOTSTRAP_IF_EMPTY=true
